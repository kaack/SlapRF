      "id": "open-qualifier",
      "title": "Open Qualifier \u0026 Finals Flow",
      "category": "qualifying",
      "categoryLabel": "Qualifying",
      "tryHash": "#/races",
      "tryLabel": "Open Race Workspace",
      "summary": "Create a race, mark active and away pilots, queue walk-up packs in an Open Qualifier, and seed the top qualifiers into Finals.",
      "youtubeVideoId": "",
      "outputFile": "open-qualifier-tutorial.mp4",
      "durationSec": 65,
      "durationLabel": "1:05",
      "maxDurationSec": 300,
      "voice": "en-US-AndrewNeural",
      "voiceRate": "+4%",
      "simSpeedMultiplier": 20,
      "steps": [
        {
          "id": "create-race",
          "startSec": 0,
          "badge": "STEP 1 · CREATE RACE",
          "caption": "Enter an event name in Race and open the new session",
          "narration": "Open the Race tab, enter a name for your event, click Add, and open Setup for the new race.",
          "actions": [
            {
              "type": "goto",
              "url": "/#/races"
            },
            {
              "type": "fill",
              "selector": "[data-race-dir-search]",
              "value": "Friday Open Qualifier"
            },
            {
              "type": "click",
              "selector": "button[data-race-act=\"create-race-inline\"]",
              "pauseBeforeMs": 300,
              "pauseAfterMs": 500
            },
            {
              "type": "click",
              "selector": "button[data-race-act=\"open-race-format\"]",
              "pauseBeforeMs": 300,
              "pauseAfterMs": 550
            },
            {
              "type": "clickIfVisible",
              "selector": ".slaprf-modal-backdrop [data-rc-modal-close]",
              "pauseAfterMs": 350
            }
          ]
        },
        {
          "id": "mark-pilots",
          "startSec": 7,
          "badge": "STEP 2 · CHECK ATTENDANCE",
          "caption": "Verify checked-in pilots in Pilots and mark absent pilots Away",
          "narration": "Open Pilots from the Run checklist to review attendance, and mark any absent pilot Away so only ready pilots enter the queue.",
          "actions": [
            {
              "type": "click",
              "selector": "button[data-mobile-ctrl-nav=\"live\"]",
              "pauseBeforeMs": 250,
              "pauseAfterMs": 550
