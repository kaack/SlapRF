*.exe
*.out
*.test
/fpvtimer
/slaprf
/slaprf-*

# OS / Editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local runtime state / build outputs
*.log
*.prof
dist/
_site/
web/wasm/*.wasm
web/wasm/*.js

# Compiled firmware image (built by CI from firmware/slaprf/; web/firmware/slaprf-xiao-c5.bin is force-added)
