# ESP-IDF build outputs
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/managed_components/

firmware/*/build-*/
*.db
*.db-wal
*.db-shm

# Portable & Android embedded site staging (populated by cmd/build-portable and cmd/build-android; .keep is tracked for go:embed)
/cmd/slaprf/site/*
!/cmd/slaprf/site/.keep
/cmd/slaprf-android/site/*
!/cmd/slaprf-android/site/.keep
slaprf.exe
slaprf.db*

# SlapRF E2E verification test artifacts (videos, traces, screenshots, HTML report)
/test-results/

# Hugo documentation build outputs & staged bundles
/docs-site/public/
/docs-site/resources/
/docs-site/.hugo_build.lock
/docs-site/static/js/docs-flasher.js
/docs-site/static/js/docs-flasher.css
