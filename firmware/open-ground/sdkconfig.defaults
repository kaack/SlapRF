# SlapRF firmware profile: open-ground (Seeed XIAO ESP32-C5)
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# App is ~0.9 MB; the 1.5 MB single-app layout leaves room to grow
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms ticks so 100 Hz sweeps pace accurately
CONFIG_FREERTOS_HZ=1000

# Logs on UART0; the native USB port is reserved for the flasher's SLAPRF? config query
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- 5.8 GHz raw-capture engine (see firmware/README.md) ----
# adctrig / force_rx_gain live in librftest.a, only linked with the RF certification test option.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# The periodic PLL-tracking timer would retune the radio underneath a sweep.
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
# Keep static code/data below the capture bank at 0x40820000 (checked by tools/check_image.sh).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_PM_ENABLE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# adctrig logs every call at INFO.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# TDMA scheduler + Wi-Fi bridge run on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# Reboot automatically on CPU panics and 5 s task-watchdog hangs (slaprf_diag halts in USB safe mode after 3 in a row)
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=0
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y


CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_TCP_MSL=3000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=3000
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880

