# SlapRF PoE Ethernet Bridge (Waveshare ESP32-P4-POE-ETH / ESP32-P4-WIFI6-POE-ETH)
CONFIG_IDF_TARGET="esp32p4"
# 4 MB image header boots cleanly on 4 MB, 8 MB, 16 MB, and 32 MB flash chips
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms FreeRTOS ticks for sub-millisecond USB <-> Ethernet ring-buffer wakeups
CONFIG_FREERTOS_HZ=1000

# Console on UART0 (routed to onboard CH343P USB-C port for flashing & diagnostics)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Internal ESP32-P4 10/100M RMII Ethernet MAC (64-byte aligned DMA buffers required on P4)
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_DMA_BUFFER_SIZE=512
CONFIG_ETH_DMA_RX_BUFFER_NUM=20
CONFIG_ETH_DMA_TX_BUFFER_NUM=20

# USB 2.0 Host OTG (Type-A Host port -> Seeed Studio XIAO ESP32-C5 Hub)
CONFIG_USB_OTG_SUPPORTED=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
CONFIG_USB_HOST_HW_BUFFER_BIAS_BALANCED=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# lwIP: DHCP + RFC 3927 Link-Local AutoIP (169.254.x.x) so direct Laptop <-> PoE Injector <-> P4
# cables work automatically even when no router/DHCP server is present on the track LAN.
CONFIG_LWIP_AUTOIP=y
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_TCP_MSL=3000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=3000
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# Watchdog & automatic panic recovery for unattended field gates
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=0
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
