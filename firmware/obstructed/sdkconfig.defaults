# SlapRF firmware profile: obstructed (Seeed XIAO ESP32-C5)
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms ticks so 100 Hz sweeps pace accurately
CONFIG_FREERTOS_HZ=1000

# Logs on UART0; the native USB port is reserved for the flasher's SLAPRF? config query
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- 5.8 GHz raw-capture engine (see firmware/README.md) ----
# adctrig / force_rx_gain live in librftest.a, only linked with the RF certification test option.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# The periodic PLL-tracking timer would retune the radio underneath a sweep.
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
# Keep static code/data below the capture bank at 0x40820000 (checked by tools/check_image.sh).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_PM_ENABLE=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# adctrig logs every call at INFO.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y# TDMA scheduler + Wi-Fi bridge run on the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
